# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 저장소에 커밋하지 마세요.
# 비밀번호 생성 예:  openssl rand -base64 24

# 공개 주소 (공유 미리보기 이미지에 사용, 끝에 / 없이)
PUBLIC_BASE_URL=https://gift.example.org
SERVER_NAME=gift.example.org

# PostgreSQL
POSTGRES_DB=giftwrap
POSTGRES_USER=giftwrap
POSTGRES_PASSWORD=CHANGE_ME

# 운영자 계정 (선택). 해시 생성은 DEPLOY.md 참고. 비워두면 관리자 API 비활성
GAME_ADMIN_USERNAME=
GAME_ADMIN_PASSWORD_HASH=
